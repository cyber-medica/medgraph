RFQ_INTAKE_HOST=127.0.0.1
RFQ_INTAKE_PORT=8787
RFQ_SMTP_HOST=smtp.yandex.ru
RFQ_SMTP_PORT=465
RFQ_SMTP_SECURE=true
RFQ_SMTP_USER=SET_MANUALLY
RFQ_SMTP_PASSWORD=SET_MANUALLY
